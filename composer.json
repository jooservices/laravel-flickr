{
    "name": "jooservices/laravel-flickr",
    "description": "Laravel Flickr integration: FlickrService entry point, adapters, opt-in queue, Mongo persistence, OAuth, rate limits, and ecosystem logging/events.",
    "type": "library",
    "keywords": [
        "laravel",
        "flickr",
        "oauth",
        "api",
        "sdk",
        "mongodb"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "JOOservices",
            "email": "admin@jooservices.com"
        }
    ],
    "support": {
        "issues": "https://github.com/jooservices/laravel-flickr/issues",
        "source": "https://github.com/jooservices/laravel-flickr"
    },
    "require": {
        "php": "^8.5",
        "illuminate/bus": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/redis": "^13.0",
        "illuminate/support": "^13.0",
        "jooservices/client": "^2.1",
        "jooservices/exceptions": "^0.5",
        "jooservices/flickr": "^2.0",
        "jooservices/laravel-config": "^1.4",
        "jooservices/laravel-controller": "^1.4",
        "jooservices/laravel-events": "^1.4",
        "jooservices/laravel-logging": "^1.2",
        "jooservices/laravel-repository": "^1.4",
        "mongodb/laravel-mongodb": "^5.7"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.9",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpmd/phpmd": "^2.13",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0|^13.0",
        "squizlabs/php_codesniffer": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JOOservices\\LaravelFlickr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JOOservices\\LaravelFlickr\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text --coverage-clover build/coverage/clover.xml",
        "lint:pint": "vendor/bin/pint --test",
        "lint:pint:fix": "vendor/bin/pint",
        "lint:phpstan": "XDEBUG_MODE=off vendor/bin/phpstan analyse --memory-limit=512M",
        "lint:phpmd": "php -d error_reporting=6143 vendor/bin/phpmd src text phpmd.xml",
        "lint:phpcs": "vendor/bin/phpcs src tests --standard=phpcs.xml",
        "lint": [
            "@lint:pint",
            "@lint:phpcs",
            "@lint:phpstan"
        ],
        "lint:all": [
            "@lint",
            "@lint:phpmd"
        ],
        "lint:fix": [
            "@lint:pint:fix"
        ],
        "check": [
            "@lint:all",
            "@test"
        ],
        "ci": [
            "@lint:all",
            "@test:coverage"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "JOOservices\\LaravelFlickr\\LaravelFlickrServiceProvider"
            ],
            "aliases": {
                "Flickr": "JOOservices\\LaravelFlickr\\Facades\\Flickr"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
